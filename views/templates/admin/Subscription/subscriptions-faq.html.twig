<div class="row">
  <div class="col">
    <div class="card" id="mollie-subscription-faq">
      <style>
        #mollie-subscription-faq .card-header { cursor: pointer; }
        #mollie-subscription-faq .card-header:not(.collapsed) .mollie-faq-chevron { transform: rotate(180deg); }
      </style>
      <h3 class="card-header d-flex justify-content-between align-items-center collapsed" data-toggle="collapse" data-target="#mollie-subscription-faq-body" aria-expanded="false" aria-controls="mollie-subscription-faq-body" role="button">
        <span><i class="material-icons">help_outline</i> {{ faq.faqTitle|escape }}</span>
        <i class="material-icons mollie-faq-chevron">expand_more</i>
      </h3>
      <div id="mollie-subscription-faq-body" class="collapse">
        <div class="card-body px-4 pb-4">
          <h4 class="mt-3 font-weight-bold">{{ faq.subscriptionCreationTittle|escape }}</h4>
          <p class="mb-1">{{ faq.subscriptionCreation|escape }}</p>

          <h4 class="mt-3 font-weight-bold">{{ faq.importantInformationTittle|escape }}</h4>
          <p class="mb-1">{{ faq.importantInformation|escape }}</p>

          <h4 class="mt-3 font-weight-bold">{{ faq.carrierInformationTitle|escape }}</h4>
          <p class="mb-1">{{ faq.carrierInformation1|escape }}</p>
          <p class="mb-1">{{ faq.carrierInformation2|escape }}</p>
          <p class="mb-1">{{ faq.carrierInformation3|escape }}</p>
          <p class="mb-1">{{ faq.carrierInformation4|escape }}</p>

          <h4 class="mt-3 font-weight-bold">{{ faq.cartRuleTitle|escape }}</h4>
          <p class="mb-1">{{ faq.cartRule1|escape }}</p>

          <h4 class="mt-3 font-weight-bold">{{ faq.giftWrappingTitle|escape }}</h4>
          <p class="mb-1">{{ faq.giftWrapping1|escape }}</p>

          <h4 class="mt-3 font-weight-bold">{{ faq.subscriptionOrderLogicTitle|escape }}</h4>
          <p class="mb-1">{{ faq.recurringOrderCreation|escape }}</p>
          <p class="mb-1">{{ faq.recurringOrderPrice|escape }}</p>
          <p class="mb-1">{{ faq.recurringOrderAPIChanges|escape }}</p>
        </div>
      </div>
    </div>
  </div>
</div>
