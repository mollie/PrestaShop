{
    "name": "mollie/prestashop",
    "license": "AFL-3.0",
    "description": "Mollie module for PrestaShop",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Invertus/Knapsack.git"
        }
    ],
    "require": {
        "ext-curl": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "prestashop/decimal": "^1.3",
        "mollie/mollie-api-php": "v2.79.1",
        "segmentio/analytics-php": "^1.5",
        "league/container": "3.3.3",
        "prestashop/module-lib-service-container": "v2.0",
        "webmozart/assert": "^1.11",
        "php-http/message-factory": "^1.1",
        "prestashop/prestashop-accounts-installer": "^1.0.4",
        "prestashop/module-lib-mbo-installer": "^3.0",
        "cweagans/composer-patches": "^1.7.3"
    },
    "require-dev": {
        "invertus/prestashop-models": "^1.0",
        "prestashop/php-dev-tools": "*",
        "phpunit/phpunit": "^7.5",
        "friendsofphp/php-cs-fixer": "^2.19"
    },
    "autoload-dev": {
        "psr-4": {
            "Mollie\\Tests\\": "tests/"
        }
    },
    "autoload": {
        "psr-4": {
            "Mollie\\": "src/",
            "Mollie\\Subscription\\": "subscription/",
            "Mollie\\Shared\\": "shared/"
        },
        "classmap": [
            "mollie.php",
            "controllers/",
            "src/",
            "subscription/"
        ]
    },
    "config": {
        "platform": {
            "php": "7.2.5"
        },
        "prepend-autoloader": false,
        "allow-plugins": {
            "php-http/discovery": false,
            "cweagans/composer-patches": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "type": "prestashop-module",
    "author": "PrestaShop",
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patches": {
            "league/container": {
                "PHP 8.4+ explicit nullable parameters": "patches/league-container-php85.patch"
            },
            "prestashop/prestashop-accounts-installer": {
                "PHP 8.4+ explicit nullable parameters": "patches/prestashop-accounts-installer-php85.patch"
            },
            "segmentio/analytics-php": {
                "PHP 8.2+ string interpolation and PHP 8.5 curl_close": "patches/segmentio-analytics-php-php85.patch"
            }
        }
    }
}
